<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 1. Tombol Explicit Intent ke SecondActivity -->
    <Button
        android:id="@+id/btnOpenSecond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buka SecondActivity"
        android:layout_centerInParent="true" />



    <!-- 2. Tombol Implicit Intent ke Browser -->
    <Button
        android:id="@+id/btnOpenBrowser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buka Browser"
        android:layout_below="@id/btnOpenSecond"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true" />

    <!-- 3. Tombol Latihan Kalkulator Luas Lingkaran -->
    <Button
        android:id="@+id/btnCircleArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hitung Luas Lingkaran"
        android:layout_below="@id/btnOpenBrowser"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true" />

</RelativeLayout>